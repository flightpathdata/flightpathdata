{"openapi":"3.1.0","info":{"title":"FlightPath Server","description":"The automation backend for <a href='https://www.flightpathdata.com'>FlightPath Data</a> ingestion projects built on <a href='https://www.csvpath.org'>CsvPath Framework</a>.","contact":{"url":"https://www.csvpath.org/getting-started/a-helping-hand","email":"info@csvpath.org","Support":"FlightPath Support"},"version":"0.1.0"},"paths":{"/projects/new_project":{"post":{"tags":["projects"],"summary":"New Project","description":"Creates a project associated with an API key. Projects are essentially config files; however, they can hold other arbitrary files as needed. The config files in a project are config.ini, the main CsvPath Framework config file, and env.json, a file that stands in for OS env vars.","operationId":"new_project_projects_new_project_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NewProjectRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/projects/delete_project":{"post":{"tags":["projects"],"summary":"Delete Project","description":"Permanently deletes a project with no recovery possible.","operationId":"delete_project_projects_delete_project_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeleteProjectRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/projects/set_project_config":{"post":{"tags":["projects"],"summary":"Set Project Config","description":"Sets the config file for a project. This is the CsvPath Framework config.ini. FlightPath Server modifies the uploaded config file to make it safe for a multi-project, multi-user server environment. In particular, local file access is turned off by default. Unless you configure permission, your files must be loaded from one of the other backends, SFTP, S3 Azure Blob, or Google Cloud Storage.","operationId":"set_project_config_projects_set_project_config_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SetProjectConfigRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/projects/get_project_names":{"post":{"tags":["projects"],"summary":"Get Project Names","description":"Returns a list of project names associated with the API key used for the request","operationId":"get_project_names_projects_get_project_names_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectNamesResponse"}}}}},"security":[{"APIKeyHeader":[]}]}},"/projects/get_project_config":{"post":{"tags":["projects"],"summary":"Get Project Config","description":"Returns the config.ini of a project, overwriting it if already present.","operationId":"get_project_config_projects_get_project_config_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GetProjectConfigRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"string","title":"Response Get Project Config Projects Get Project Config Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/projects/set_env_file":{"post":{"tags":["projects"],"summary":"Set Env File","description":"Sets the env.json file, overwriting it if already present. `env.json` holds values that you would otherwise get from OS environment variables. Because FlightPath Server is a multi-project environment the OS env vars are not used. Instead when you deploy a project you copy the env vars into env.json, where they can be used in exactly the same way.","operationId":"set_env_file_projects_set_env_file_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SetEnvFileRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/projects/get_env_file":{"post":{"tags":["projects"],"summary":"Get Env File","description":"Returns a project's env.json file.","operationId":"get_env_file_projects_get_env_file_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GetEnvFileRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"string","title":"Response Get Env File Projects Get Env File Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/projects/set_env_key":{"post":{"tags":["projects"],"summary":"Set Env Key","description":"Sets an variable in env.json that can be used within a project's config.ini file in the same way as an OS env var.","operationId":"set_env_key_projects_set_env_key_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SetEnvKeyRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/projects/add_file":{"post":{"tags":["projects"],"summary":"Add File","description":"Stores an arbitrary base64 encoded file in a project. The file can go in a folder, which is created if needed, but it cannot be put in the config folder.","operationId":"add_file_projects_add_file_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddFileRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/projects/get_file":{"post":{"tags":["projects"],"summary":"Get File","description":"Returns a base64 encoded file from the project. The file cannot be in the config directory. Keep in mind that you cannot get named-files, named-paths group files, or results using this endpoint. Those files aren't __in__ the project, even if they were generated by the project.","operationId":"get_file_projects_get_file_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/flightpath_server__routers__project_router__GetFileRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/csvpath/register_file":{"post":{"tags":["register"],"summary":"Register File","description":"Registers a new version of a named file. In CsvPath Framework terms, this is CsvPaths.FileManager.add_named_file().","operationId":"register_file_csvpath_register_file_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterFileRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReferenceResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/csvpath/register_csvpath_group":{"post":{"tags":["register"],"summary":"Register Csvpath Group","description":"Registers a named-paths group, creating a new version if the named-paths group already exists. In CsvPath Framework terms, this is CsvPaths.PathsManager.add_named_paths().","operationId":"register_csvpath_group_csvpath_register_csvpath_group_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterCsvpathsRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReferenceResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/csvpath/run":{"post":{"tags":["run"],"summary":"Run","description":"Runs a named-file through a named-paths group. In CsvPath Framework terms, this is one of the following:\n<ul>\n    <li> CsvPaths.collect_paths()\n    <li> CsvPaths.fast_forward_paths()\n    <li> CsvPaths.collect_by_line()\n    <li> CsvPaths.fast_forward_by_line()\n</ul>","operationId":"run_csvpath_run_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReferenceResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/csvpath/register_and_run":{"post":{"tags":["register","run"],"summary":"Register And Run","description":"Registers a new version of a named-file and then runs it through a named-paths group. This endpoint can be used by MFT servers or other file arrival-watching tools to both collect a file and start a run in one action.","operationId":"register_and_run_csvpath_register_and_run_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterAndRunRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReferencesResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/csvpath/get_run_path":{"post":{"tags":["results"],"summary":"Get Run Path","description":"Returns the path to a run's `run_dir`. `run_dir` is the name of the directory where a runs results live. It is a date-stamp name below the named-paths name in the form YYYY-MM_DD_HH-MM-SS.","operationId":"get_run_path_csvpath_get_run_path_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunPathRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PathResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/csvpath/find_completed_runs":{"post":{"tags":["results"],"summary":"Find Completed Runs","description":"Returns paths to all the runs matching a reference. Each run found will have its own set of csvpath statement results.","operationId":"find_completed_runs_csvpath_find_completed_runs_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunReferenceRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorsResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/csvpath/get_run_errors":{"post":{"tags":["results"],"summary":"Get Run Errors","description":"Returns the contents of all the errors.json files generated during a run. Each csvpath in a named-paths group has its own errors.json file, if errors happened during the run. This endpoint aggregates them.","operationId":"get_run_errors_csvpath_get_run_errors_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunReferenceRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorsResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/csvpath/get_run_metadata":{"post":{"tags":["results"],"summary":"Get Run Metadata","description":"Returns the metadata fields and runtime data generated during the run. Metadata fields are settings and user-defined content embedded in comments of a csvpath. Runtime data tracks validity, lines matched, headers, and other metadata that is generated as the run happens. This endpoint aggregates the metadata of all csvpaths within the named-paths group that was run.","operationId":"get_run_metadata_csvpath_get_run_metadata_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunReferenceRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MetadataResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/csvpath/get_run_variables":{"post":{"tags":["results"],"summary":"Get Run Variables","description":"Returns the run variables. Run variables are user-defined values set within csvpaths, line-by-line. This endpoint aggregates the variables.json files of each of the csvpaths in the named-paths group that was run.","operationId":"get_run_variables_csvpath_get_run_variables_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunReferenceRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VariablesResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/csvpath/get_run_printouts":{"post":{"tags":["results"],"summary":"Get Run Printouts","description":"Returns the printouts of a printstream, aggregated from all the csvpaths in the named-paths group that was run.","operationId":"get_run_printouts_csvpath_get_run_printouts_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunReferencePrintRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PrintoutsResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/admin/new_key":{"post":{"tags":["admin"],"summary":"New Key","description":"Creates a new key. When any keys have been made this request requires an API header.\nWhen no keys have been made, the request creates and returns the server's admin key.\nAny user can create a new key. Keys are a way of grouping and protecting projects. They\nare not an individual user security capability.","operationId":"new_key_admin_new_key_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NewKeyRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NewKeyResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/admin/active_runs":{"get":{"tags":["admin"],"summary":"Get Active Runs","description":"Returns information on any runs that are currently in progress.","operationId":"get_active_runs_admin_active_runs_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ActiveRunsResponse"}}}}},"security":[{"APIKeyHeader":[]}]}},"/admin/shutdown":{"get":{"tags":["admin"],"summary":"Shutdown","description":"Shuts down the server. Use with care. There is no cooling down period; sessions and runs will be immediately terminated.","operationId":"shutdown_admin_shutdown_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}},"security":[{"APIKeyHeader":[]}]}},"/admin/make_admin_key":{"post":{"tags":["admin"],"summary":"Make Admin Key","description":"Sets a key to be an admin key. Requires an admin key in the header.","operationId":"make_admin_key_admin_make_admin_key_post","requestBody":{"content":{"application/json":{"schema"